 "tips": [
  {
   "title": "ייבוש הבשר לפני הצלייה",
   "excerpt": "לפני שאתם מניחים את הבשר על הגריל או על המחבת, כדאי לייבשו בעזרת מגבת נייר. הבשר היבש מקבל קראסט מושלם וחום אחיד."
  },
  {
   "title": "בשר בקר – תזונה וערכים",
   "excerpt": "בשר בקר הוא מקור מצוין לחלבון איכותי, ברזל, אבץ וויטמין B12, החיוניים לתפקוד הגוף."
  },
  {
   "title": "בשר בטמפרטורת החדר",
   "excerpt": "לפני ההכנה, מומלץ להוציא את הבשר מהמקרר ולתת לו להגיע לטמפרטורת החדר. בשר קר ישירות מהמקרר לא יבשיל באופן אחיד."
  },
  {
   "title": "לא לזרוק שומן!",
   "excerpt": "השומן שמקיף את הסטייק הוא מקור עושר טעמים שמוסיף עסיסיות ומרקם ייחודי."
  },
  {
   "title": "מלח רק בסוף!",
   "excerpt": "רבים ממליחים את הבשר לפני הצלייה – אך זו טעות שמייבשת את הסטייק. מלח \"שואב\" נוזלים."
  },
  {
   "title": "ניחוחות של עץ",
   "excerpt": "אם יש לכם גריל, הוסיפו שבבי עץ רטובים – דובדבן, אלון או היקורי. כשהם מתחממים, הם משחררים עשן ארומטי."
  },
  {
   "title": "צלי מושלם – תנו לבשר לנוח",
   "excerpt": "לאחר הצלייה, תנו לבשר \"לנוח\" מכוסה כ-10 דקות לפני החיתוך, כדי שלא יאבד נוזלים."
  }
 ],
 "recipeDetails": {
  "רוסטביף-אנטריקוט-צרפתי": {
   "slug": "רוסטביף-אנטריקוט-צרפתי",
   "method": "תנור ביתי / גריל שטח",
   "ingredients": [
    "1.5 ק\"ג נתח אנטריקוט לתנור",
    "שמן זית",
    "חומץ בלסמי",
    "יין אדום יבש",
    "ברנדי/וויסקי",
    "טימין",
    "עלי דפנה",
    "מלח גס, פלפל שחור גרוס"
   ],
   "steps": [
    "בסיר רחב להניח את הנתח ולשפוך 2 כוסות יין אדום יבש, כוס ברנדי/וויסקי, חצי כוס שמן זית, 2 כפות חומץ בלסמי, 5 עלי דפנה, כף פלפל שחור גרוס וצרור טימין. להכניס למקרר ל-24 שעות.",
